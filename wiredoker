docker run -d \
  --name=wireguard-vpn \
  --cap-add=NET_ADMIN \
  --cap-add=SYS_MODULE \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=Europe/Moscow \
  -e SERVERURL=10.10.0.100 ` # ВНИМАНИЕ: Замените этот IP на текущий локальный IP вашей Ubuntu (br0) ` \
  -e SERVERPORT=51820 \
  -e PEERS=phone,home-pc \
  -e PEERDNS=auto \
  -p 51820:51820/udp \
  -v /opt/wireguard/config:/config \
  -v /lib/modules:/lib/modules \
  --restart always \
  lscr.io/linuxserver/wireguard:latest
